<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SpendWise" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>

        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_surface_subtle</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke_subtle</item>
        <item name="colorOutlineVariant">@color/stroke_subtle</item>

        <item name="colorError">@color/danger_primary</item>
        <item name="colorOnError">@color/onError</item>

        <!-- Bottom Navigation — emerald active indicator -->
        <item name="bottomNavigationStyle">@style/Widget.SpendWise.BottomNav</item>

        <item name="bottomSheetDialogTheme">@style/Theme.SpendWise.BottomSheetDialog</item>
    </style>

    <!-- Bottom Navigation Style: Floating Frosted-Glass Pill -->
    <style name="Widget.SpendWise.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SpendWise.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_icon_tint</item>
        <item name="itemTextColor">@color/bottom_nav_icon_tint</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.SpendWise.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.SpendWise.BottomNav.Inactive</item>
    </style>

    <style name="Widget.SpendWise.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_active_halo</item>
        <item name="android:width">44dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SpendWise.NavActiveHalo</item>
    </style>

    <style name="ShapeAppearance.SpendWise.NavActiveHalo" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TextAppearance.SpendWise.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SpendWise.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.SpendWise.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SpendWise.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Widget.SpendWise.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.SpendWise.BottomSheet</item>
        <item name="backgroundTint">@color/bg_surface</item>
    </style>

    <style name="ShapeAppearance.SpendWise.BottomSheet" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TextAppearance.SpendWise.PrefixBold" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="ShapeAppearanceOverlay.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
