<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/stroke_subtle"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Left Icon Badge (40dp x 40dp, 12dp radius, 15% opacity tint of category color) -->
        <FrameLayout
            android:id="@+id/layout_category_badge"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <!-- Legacy view_color_dot placeholder to guarantee zero binding disruption -->
            <View
                android:id="@+id/view_color_dot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/iv_category_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_cat_food"/>
        </FrameLayout>

        <!-- Category Name -->
        <TextView
            android:id="@+id/tv_category_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Entertainment"/>

        <!-- Interactive Budget Pill Badge -->
        <TextView
            android:id="@+id/tv_category_budget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4.5dp"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_pill_budget_empty"
            android:textColor="@color/text_secondary"
            tools:text="Rs 5,000 / mo"/>

        <!-- Delete Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_category"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconTint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:backgroundTint="@android:color/transparent"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
