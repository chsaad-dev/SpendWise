<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Member Name -->
        <TextView
            android:id="@+id/tv_member_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Member"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Equal split: read-only label; Custom split: editable input -->
        <TextView
            android:id="@+id/tv_member_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Rs 0.00"
            android:textColor="@color/brand_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_member_amount"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="end|center_vertical"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:textColor="@color/brand_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Remove Button -->
        <ImageButton
            android:id="@+id/btn_delete_member"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove member"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
