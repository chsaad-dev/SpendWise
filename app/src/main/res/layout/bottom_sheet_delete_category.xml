<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="center_horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle Pill -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Centered Warning Halo -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_danger_halo">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_delete"
            app:tint="@color/danger_primary"
            android:contentDescription="@null"/>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_delete_category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="Delete &quot;Others&quot;?"/>

    <!-- Copy / Description -->
    <TextView
        android:id="@+id/tv_delete_category_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="Existing expenses using this category will keep their label."/>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_delete_category"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:text="Delete Category"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/danger_primary"
        app:cornerRadius="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_delete_category"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/bg_surface_subtle"
        app:cornerRadius="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:elevation="0dp"/>

</LinearLayout>
