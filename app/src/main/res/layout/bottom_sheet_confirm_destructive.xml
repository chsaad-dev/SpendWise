<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Centered Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Clean Bold Title -->
    <TextView
        android:id="@+id/tv_destructive_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        tools:text="Clear All Expenses"/>

    <!-- Concise Warning Subtitle -->
    <TextView
        android:id="@+id/tv_destructive_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp"
        tools:text="This will permanently delete all your expense records. This action cannot be undone."/>

    <!-- Destructive Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_destructive_confirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/danger_primary"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        tools:text="Delete Everything"/>

    <!-- Tonal Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_destructive_cancel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/bg_surface_subtle"
        app:cornerRadius="14dp"
        app:elevation="0dp"/>

</LinearLayout>
